[Unit]
Description=TalkType Chonk transcriber (transcribe.cpp wrapper)
After=network.target

[Service]
User=pibulus
WorkingDirectory=/home/pibulus/talktype-transcriber
ExecStart=/usr/bin/node /home/pibulus/talktype-transcriber/server.mjs
Environment=PORT=7331
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
